# ==============================================================================
# Digitaler IT-Lieferschein - Konfiguration (.env)
# ==============================================================================

# --- Allgemeine Anwendungseinstellungen ---
APP_TITLE="Digitaler IT-Lieferschein"
DEPARTMENT_NAME="Stadtverwaltung – Schul-IT / Amt für Bildung und Sport"
DEPARTMENT_SUBTITLE="Kommunale IT-Betreuung der Schulen"
DEPARTMENT_CONTACT="schul-it@kommune.local | Tel. 01234 / 567-890"
TIMEZONE="Europe/Berlin"

# --- Datenbank & Speicherorte ---
# Im Docker-Container zeigt /app/data auf das gemountete persistente Volume
DATA_DIR="./data"
DATABASE_URL="sqlite:///./data/lieferscheine.db"
PDF_STORAGE_DIR="./data/pdfs"

# --- Sicherheit & Verschlüsselung ---
# Optionaler Schlüssel zur Verschlüsselung sensibler Einstellungen in der DB (z. B. SMTP-Passwort).
# Wenn leer, wird automatisch ein sicherer Schlüssel unter DATA_DIR/.secret_key erzeugt.
SECRET_KEY=""

# Anmeldepflicht beim Erststart (alle weiteren Einstellungen & Benutzer werden im Web-Konfigmenü verwaltet)
AUTH_ENABLED="true"

# --- SMTP E-Mail-Konfiguration (Initialwerte für das Web-Konfigmenü) ---
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
# Mögliche Werte für SMTP_SECURITY: "starttls", "ssl", "none"
SMTP_SECURITY="starttls"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Schul-IT Lieferschein-System"
SMTP_TIMEOUT="15"

# --- osTicket & Archiv-Integration (Initialwerte für das Web-Konfigmenü) ---
OSTICKET_EMAIL=""
GLOBAL_ARCHIVE_CC_EMAIL=""
