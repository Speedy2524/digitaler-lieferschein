# ==============================================================================
# Digitaler IT-Lieferschein - Konfiguration (.env)
# ==============================================================================

# --- Allgemeine Anwendungseinstellungen ---
APP_TITLE="Digitaler IT-Lieferschein"
DEPARTMENT_NAME="Stadtverwaltung – Schul-IT / Amt für Bildung und Sport"
DEPARTMENT_SUBTITLE="Kommunale IT-Betreuung der Schulen"
DEPARTMENT_CONTACT="schul-it@kommune.local | Tel. 07171 / 123-456"
TIMEZONE="Europe/Berlin"

# --- Datenbank & Speicherorte ---
# Im Docker-Container zeigt /app/data auf das gemountete persistente Volume
DATA_DIR="./data"
DATABASE_URL="sqlite:///./data/lieferscheine.db"
PDF_STORAGE_DIR="./data/pdfs"

# --- Zugriffsschutz (Optional) ---
# Wenn AUTH_ENABLED=true, ist die Anwendung geschützt.
# Unterstützt sowohl PIN-Login über die Web-Oberfläche als auch HTTP Basic Auth.
AUTH_ENABLED="false"
AUTH_USERNAME="it-team"
AUTH_PASSWORD="changeme123"
AUTH_PIN="1234"

# --- SMTP E-Mail-Konfiguration ---
# Wenn SMTP_ENABLED=false, werden E-Mails nur im Log simuliert (Testmodus)
SMTP_ENABLED="false"
SMTP_HOST="mail.kommune.local"
SMTP_PORT="587"
# Mögliche Werte für SMTP_SECURITY: "starttls", "ssl", "none" (z.B. für internen Exchange-Relay)
SMTP_SECURITY="starttls"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="schul-it@kommune.local"
SMTP_FROM_NAME="Schul-IT Lieferschein-System"
SMTP_TIMEOUT="15"

# --- osTicket & Archiv-Integration ---
# Wenn konfiguriert und im Lieferschein eine osTicket-Nr. hinterlegt ist,
# wird automatisch eine E-Mail mit Betreff "[#<TICKETNR>] Lieferschein <LS-NR> - <Schule>" gesendet.
OSTICKET_EMAIL="tickets@kommune.local"

# Optionale globale CC-Adresse für alle Schul-Lieferscheine (z.B. IT-Archivpostfach)
GLOBAL_ARCHIVE_CC_EMAIL=""
